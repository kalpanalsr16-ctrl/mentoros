# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — it will never be committed.

# Supabase project URL.
# Find it in: Supabase Dashboard -> Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase "anon public" key.
# Find it in: Supabase Dashboard -> Project Settings -> API Keys -> anon public
# This key is safe to expose to the browser — it has no special privileges on
# its own. Row Level Security policies (added in Task 3) are what actually
# control who can read or write which rows.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sentry DSN (error monitoring).
# Find it in: Sentry -> your project -> Settings -> Client Keys (DSN)
# A DSN is safe to expose to the browser -- like the Supabase anon key,
# it has no special privileges; it's just "where to send error reports."
NEXT_PUBLIC_SENTRY_DSN=
